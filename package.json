{
  "name": "monett-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for NestJS Backend, Expo Mobile/Web, and Shared Types",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,MOBILE\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:mobile\"",
    "dev:all": "node scripts/start-all.js",
    "dev:lan": "node scripts/start-lan.js",
    "dev:all:tunnel": "concurrently -n \"BACKEND,MOBILE\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:mobile:tunnel -- -c\"",
    "dev:backend": "npm run start:dev --workspace=@monett/backend",
    "dev:mobile": "npm run start --workspace=@monett/mobile-web",
    "dev:mobile:tunnel": "npm run start:tunnel --workspace=@monett/mobile-web",
    "build:backend": "npm run build --workspace=@monett/backend",
    "build:shared": "npm run build --workspace=@monett/shared",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@nestjs/platform-socket.io": "^10.3.8",
    "@nestjs/websockets": "^10.3.8",
    "jimp": "^1.6.1",
    "socket.io": "^4.7.5"
  }
}
