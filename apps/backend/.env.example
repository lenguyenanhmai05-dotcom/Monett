# ============================================================
# CẤU HÌNH MÔI TRƯỜNG CHO BACKEND (NESTJS API - PORT 3000)
# Tạo file .env trong thư mục apps/backend và điền các giá trị bên dưới
# ============================================================

PORT=3000
NODE_ENV=development

# 1. Cơ sở dữ liệu MongoDB Atlas
# (Đã mở IP 0.0.0.0/0 trên cụm chung, thành viên có thể dùng chuỗi kết nối của nhóm hoặc tạo DB riêng)
MONGODB_USERNAME="your_mongodb_username"
MONGODB_PASSWORD="your_mongodb_password"
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.0al5pfn.mongodb.net/monett?retryWrites=true&w=majority"

# 2. Cấu hình bảo mật JWT Token
JWT_SECRET="monett_super_secret_jwt_key_2026_finance_moments"
JWT_EXPIRES_IN="7d"

# 3. Google OAuth 2.0 (Lấy từ Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs)
# Loại ứng dụng: Web Application
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# 4. Cấu hình gửi mã OTP qua Gmail (Nodemailer SMTP)
# Lưu ý: MAIL_PASS là Mật khẩu ứng dụng (App Password) gồm 16 chữ số tạo trong tài khoản Google
# (Bật Xác minh 2 bước -> Tìm "Mật khẩu ứng dụng" / "App Passwords")
MAIL_USER="your_email@gmail.com"
MAIL_PASS="your_16_digit_app_password"
MAIL_FROM="Monett Finance <your_email@gmail.com>"
