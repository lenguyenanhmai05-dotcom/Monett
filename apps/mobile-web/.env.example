# ============================================================
# CẤU HÌNH MÔI TRƯỜNG CHO FRONTEND (EXPO MOBILE & WEB)
# Tạo file .env trong thư mục apps/mobile-web và điền các giá trị bên dưới
# ============================================================

# 1. Google OAuth Client ID (Lấy từ Google Cloud Console - Web Application)
# Dùng chung Client ID này để đồng bộ xác thực giữa Web và Mobile
EXPO_PUBLIC_GOOGLE_CLIENT_ID="736231837435-gpto7efhb6refpinmio7b70coi273e5c.apps.googleusercontent.com"

# 2. Địa chỉ máy chủ Backend (NestJS Port 3000)
# - Khi chạy test trên trình duyệt Web (PC): Để mặc định "http://localhost:3000"
# - Khi chạy test trên điện thoại thật (Expo Go): Điền link Tunnel (Cloudflare/ngrok)
#   Ví dụ: "https://ultimate-alert-blues-vary.trycloudflare.com"
EXPO_PUBLIC_API_URL="http://localhost:3000"

# 3. Expo Token (Tùy chọn, chỉ cần khi build app EAS hoặc publish lên Expo cloud)
# EXPO_TOKEN="your_expo_token_here"
